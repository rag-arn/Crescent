<?xml version="1.0" encoding="utf-8"?>
<!-- Shared background of the dashboard and every activity:
     cream page + the green ornamental header (gradient, rosettes, crescents, domes)
     whose bottom edge is a scalloped curve with a light stroke band.
     bg_green_arc is stretched to the full width and keeps its own height. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. Cream page -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sage_bottom"/>
        </shape>
    </item>

    <!-- 2. Green header with all ornaments -->
    <item
        android:drawable="@drawable/bg_green_arc"
        android:gravity="top|fill_horizontal"/>

</layer-list>
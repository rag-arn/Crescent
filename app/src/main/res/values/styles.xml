<resources>
    <style name="Theme.Crescent" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/sage_text</item>
        <item name="colorPrimaryVariant">@color/sage_text</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/sage_text</item>
        <item name="colorSecondaryVariant">@color/sage_text</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSurface">@color/sage_card</item>
        <item name="colorOnSurface">@color/sage_text</item>
        <item name="colorControlNormal">@color/sage_text_soft</item>
        <item name="colorControlActivated">@color/sage_text</item>
        <item name="android:colorBackground">@color/sage_bottom</item>
        <item name="android:windowBackground">@color/sage_bottom</item>
        <item name="android:textColorPrimary">@color/sage_text</item>
        <item name="android:textColorSecondary">@color/sage_text_soft</item>
        <item name="android:textColorHint">@color/sage_text_soft</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Primary action -->
    <style name="Widget.Crescent.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/sage_text</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <!-- Secondary action -->
    <style name="Widget.Crescent.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/sage_text</item>
        <item name="android:textColor">@color/sage_text</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <!-- Tertiary action -->
    <style name="Widget.Crescent.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/sage_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <!-- Text Inputs -->
    <style name="Widget.Crescent.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/sage_text</item>
        <item name="android:textColorHint">@color/sage_text_soft</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
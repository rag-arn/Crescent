<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dropdown selector (units, purity) -->
    <style name="Widget.Crescent.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/bg_spinner</item>
        <item name="android:popupBackground">@drawable/bg_spinner_popup</item>
        <item name="android:spinnerMode">dropdown</item>
    </style>

    <!-- Small caption above a field -->
    <style name="CrescentFieldLabel">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/sage_text_soft</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
</resources>

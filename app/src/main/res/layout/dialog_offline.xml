<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="20dp" android:background="@drawable/bg_dash_card"
    android:layout_width="match_parent" android:layout_height="wrap_content">

    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <ImageView android:id="@+id/dialogIcon" android:src="@drawable/ic_airplane" android:tint="@color/sage_button" android:importantForAccessibility="no"
            android:layout_width="24dp" android:layout_height="24dp"/>
        <TextView android:id="@+id/dialogTitle" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/sage_text"
            android:layout_marginStart="12dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
    </LinearLayout>

    <ScrollView android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/dialogMessage" android:textSize="15sp" android:textColor="@color/sage_text" android:lineSpacingExtra="4dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </ScrollView>

    <LinearLayout android:orientation="horizontal" android:layout_marginTop="18dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/dialogSettings" style="@style/Widget.Crescent.Button.Outlined" android:text="Settings"
            android:layout_marginEnd="6dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <Button android:id="@+id/dialogOk" style="@style/Widget.Crescent.Button" android:text="Got it"
            android:layout_marginStart="6dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
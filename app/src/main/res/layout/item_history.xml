<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content">

    <!-- Back layer: the delete action revealed when the card is swiped left -->
    <FrameLayout
        android:id="@+id/historyBack"
        android:layout_width="80dp" android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_history_delete"
        android:visibility="invisible">
        <ImageButton
            android:id="@+id/historyDelete"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:src="@drawable/ic_delete"
            android:scaleType="center"
            android:padding="0dp"
            android:contentDescription="Delete calculation"/>
    </FrameLayout>

    <!-- Front layer: the calculation card -->
    <LinearLayout
        android:id="@+id/historyFront"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@drawable/bg_asset_card"
        android:foreground="?android:attr/selectableItemBackground"
        android:clickable="true" android:focusable="true">

        <FrameLayout
            android:layout_width="40dp" android:layout_height="40dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_icon_box">
            <ImageView
                android:layout_width="20dp" android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_history"
                android:tint="@color/sage_button"
                android:contentDescription="@null"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/historyDate"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="17sp" android:textStyle="bold" android:textColor="@color/sage_text"/>
            <TextView android:id="@+id/historyAssets"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp" android:textColor="@color/sage_text_soft"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
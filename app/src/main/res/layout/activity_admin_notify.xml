<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout" android:orientation="vertical"
    android:background="@drawable/bg_dash_screen_soft"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <FrameLayout android:id="@+id/headerBar" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="10dp" android:paddingTop="42dp" android:paddingBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <ImageButton android:id="@+id/backButton" style="?android:attr/borderlessButtonStyle" android:src="@drawable/ic_back_arrow" android:tint="@color/sage_text" android:layout_marginEnd="12dp" android:layout_width="44dp" android:layout_height="44dp"/>
            <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                <TextView android:text="Admin" android:textSize="11sp" android:textStyle="bold" android:textAllCaps="true" android:letterSpacing="0.1" android:textColor="@color/sage_text_soft" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Send Notification" android:fontFamily="serif" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/sage_text" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:orientation="vertical" android:padding="24dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="This message is sent to every registered user of the app." android:textSize="15sp" android:textColor="@color/sage_text" android:layout_marginBottom="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

            <TextView android:text="Title" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/sage_text" android:layout_marginBottom="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <EditText android:id="@+id/notifTitleInput" style="@style/Widget.Crescent.EditText" android:hint="Title of notification" android:inputType="textCapSentences" android:maxLength="60" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content"/>

            <TextView android:text="Description" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/sage_text" android:layout_marginTop="18dp" android:layout_marginBottom="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <EditText android:id="@+id/notifMessageInput" style="@style/Widget.Crescent.EditText" android:hint="Write the message here..." android:lines="5" android:gravity="top" android:inputType="textMultiLine|textCapSentences" android:maxLength="300" android:layout_width="match_parent" android:layout_height="wrap_content"/>

            <Button android:id="@+id/sendNotifBtn" style="@style/Widget.Crescent.Button" android:text="Send to all users" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <ProgressBar android:id="@+id/sendProgress" android:visibility="gone" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

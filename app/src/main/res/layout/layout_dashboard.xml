<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_dash_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/brandHeader"
        android:paddingTop="42dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageButton android:id="@+id/menuButton"
                    style="?android:attr/borderlessButtonStyle"
                    android:src="@drawable/ic_menu"
                    android:tint="@color/sage_text"
                    android:padding="14dp"
                    android:contentDescription="Menu"
                    android:layout_width="52dp"
                    android:layout_height="52dp"/>

                <FrameLayout android:id="@+id/logoContainer"
                    android:background="@drawable/bg_dash_logo_ring"
                    android:padding="2dp"
                    android:layout_marginStart="2dp"
                    android:layout_width="56dp"
                    android:layout_height="56dp">
                    <ImageView android:id="@+id/logoImage"
                        android:src="@drawable/logo"
                        android:scaleType="centerCrop"
                        android:importantForAccessibility="no"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </FrameLayout>

                <TextView android:text="CRESCENT"
                    android:fontFamily="serif"
                    android:textSize="30sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold"
                    android:textColor="@color/sage_text"
                    android:layout_marginStart="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <Space android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>

                <FrameLayout android:id="@+id/notifButton"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="52dp" android:layout_height="52dp">
                    <ImageView android:src="@drawable/ic_bell" android:tint="@color/sage_text" android:layout_gravity="center" android:layout_width="24dp" android:layout_height="24dp"/>
                    <View android:id="@+id/notifDot" android:background="@drawable/bg_red_dot" android:visibility="gone" android:layout_gravity="top|end" android:layout_marginTop="8dp" android:layout_marginEnd="9dp" android:layout_width="10dp" android:layout_height="10dp"/>
                </FrameLayout>

            </LinearLayout>

            <LinearLayout
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:layout_marginTop="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView android:id="@+id/englishDateText"
                    android:text="—"
                    android:textSize="14sp"
                    android:textColor="@color/sage_text_soft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView android:id="@+id/arabicDateText"
                    android:text="—"
                    android:fontFamily="serif"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/sage_text"
                    android:layout_marginTop="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="false">
        <LinearLayout
            android:orientation="vertical"
            android:paddingStart="18dp" android:paddingEnd="18dp"
            android:paddingTop="6dp" android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_dash_card"
                android:elevation="8dp" android:outlineSpotShadowColor="@color/sage_shadow_spot" android:outlineAmbientShadowColor="@color/sage_shadow_ambient"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView android:text="Zakat Status"
                    android:fontFamily="serif"
                    android:textSize="18sp" android:textStyle="bold"
                    android:textColor="@color/sage_text"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <FrameLayout android:layout_width="152dp" android:layout_height="152dp">
                        <com.crescent.app.GaugeView android:id="@+id/zakatGauge"
                            android:layout_width="match_parent" android:layout_height="match_parent"/>
                        <LinearLayout
                            android:orientation="vertical" android:gravity="center"
                            android:paddingStart="20dp" android:paddingEnd="20dp"
                            android:layout_gravity="center"
                            android:layout_width="match_parent" android:layout_height="match_parent">
                            <TextView android:id="@+id/zakatYearText"
                                android:text="Your Zakat" android:textSize="12sp"
                                android:textColor="@color/sage_text_soft" android:gravity="center"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:id="@+id/zakatAmountCircle"
                                android:text="0 BDT" android:textSize="22sp" android:textStyle="bold"
                                xmlns:app="http://schemas.android.com/apk/res-auto"
                                app:autoSizeTextType="uniform" app:autoSizeMinTextSize="12sp" app:autoSizeMaxTextSize="22sp" app:autoSizeStepGranularity="1sp"
                                android:textColor="@color/sage_text" android:gravity="center"
                                android:maxLines="1"
                                android:layout_marginTop="3dp" android:layout_marginBottom="3dp"
                                android:layout_width="match_parent" android:layout_height="wrap_content"/>
                            <TextView android:id="@+id/zakatStateText"
                                android:text="Not calculated" android:textSize="12sp"
                                android:textColor="@color/sage_text_soft"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:orientation="vertical" android:gravity="center_horizontal"
                        android:layout_marginStart="14dp"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                        <TextView android:id="@+id/payNowBtn"
                            android:text="Pay Now" android:textSize="14sp" android:textStyle="bold"
                            android:textColor="#FFFFFF" android:gravity="center"
                            android:background="@drawable/bg_dash_btn"
                            android:paddingStart="34dp" android:paddingEnd="34dp"
                            android:paddingTop="10dp" android:paddingBottom="10dp"
                            android:minHeight="42dp"
                            android:layout_marginTop="4dp"
                            android:elevation="6dp"
                            android:outlineSpotShadowColor="@color/sage_btn_pressed"
                            android:outlineAmbientShadowColor="@color/sage_btn"
                            android:clickable="true" android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/detailedBreakdownBtn"
                            android:text="Detailed Breakdown" android:textSize="10.5sp" android:textStyle="bold"
                            android:textColor="@color/sage_text"
                            android:paddingTop="8dp" android:paddingBottom="8dp"
                            android:layout_marginTop="8dp"
                            android:clickable="true" android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Lunar-year (hawl) progress -->
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_marginTop="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:text="Lunar year progress"
                            android:textSize="12sp" android:textStyle="bold"
                            android:textColor="@color/sage_text"
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/hawlDaysText"
                            android:text="Not started"
                            android:textSize="12sp" android:textStyle="bold"
                            android:textColor="@color/sage_text"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <ProgressBar android:id="@+id/hawlProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:max="1000" android:progress="0"
                        android:progressDrawable="@drawable/progress_sage"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent" android:layout_height="8dp"/>
                    <TextView android:id="@+id/hawlDueText"
                        android:text=""
                        android:textSize="11sp"
                        android:textColor="@color/sage_text_soft"
                        android:layout_marginTop="6dp"
                        android:layout_width="match_parent" android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:orientation="horizontal" android:layout_marginTop="16dp"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:id="@+id/gridCalculate"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="16dp" android:paddingBottom="16dp"
                    android:background="@drawable/bg_dash_card" android:elevation="5dp" android:outlineSpotShadowColor="@color/sage_shadow_spot" android:outlineAmbientShadowColor="@color/sage_shadow_ambient" android:layout_marginEnd="6dp"
                    android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                    <TextView android:text="Calculate\nZakat" android:textSize="14sp" android:textStyle="bold"
                        android:textColor="@color/sage_text" android:lineSpacingExtra="1dp"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                    <ImageView android:src="@drawable/ic_calculator" android:tint="@color/sage_text_soft"
                        android:importantForAccessibility="no" android:layout_width="30dp" android:layout_height="30dp"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/gridAssets"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="16dp" android:paddingBottom="16dp"
                    android:background="@drawable/bg_dash_card" android:elevation="5dp" android:outlineSpotShadowColor="@color/sage_shadow_spot" android:outlineAmbientShadowColor="@color/sage_shadow_ambient" android:layout_marginStart="6dp"
                    android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                    <TextView android:text="Asset\nBreakdown" android:textSize="14sp" android:textStyle="bold"
                        android:textColor="@color/sage_text" android:lineSpacingExtra="1dp"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                    <ImageView android:src="@drawable/ic_pie" android:tint="@color/sage_text_soft"
                        android:importantForAccessibility="no" android:layout_width="30dp" android:layout_height="30dp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:orientation="horizontal" android:layout_marginTop="12dp"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:id="@+id/gridHistory"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="16dp" android:paddingBottom="16dp"
                    android:background="@drawable/bg_dash_card" android:elevation="5dp" android:outlineSpotShadowColor="@color/sage_shadow_spot" android:outlineAmbientShadowColor="@color/sage_shadow_ambient" android:layout_marginEnd="6dp"
                    android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                    <TextView android:text="Zakat\nHistory" android:textSize="14sp" android:textStyle="bold"
                        android:textColor="@color/sage_text" android:lineSpacingExtra="1dp"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                    <ImageView android:src="@drawable/ic_history" android:tint="@color/sage_text_soft"
                        android:importantForAccessibility="no" android:layout_width="30dp" android:layout_height="30dp"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/gridChat"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="16dp" android:paddingBottom="16dp"
                    android:background="@drawable/bg_dash_card" android:elevation="5dp" android:outlineSpotShadowColor="@color/sage_shadow_spot" android:outlineAmbientShadowColor="@color/sage_shadow_ambient" android:layout_marginStart="6dp"
                    android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                    <TextView android:text="Chat with\nExpert" android:textSize="14sp" android:textStyle="bold"
                        android:textColor="@color/sage_text" android:lineSpacingExtra="1dp"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                    <ImageView android:src="@drawable/ic_chat" android:tint="@color/sage_text_soft"
                        android:importantForAccessibility="no" android:layout_width="30dp" android:layout_height="30dp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:orientation="vertical" android:gravity="center"
                android:paddingStart="56dp" android:paddingEnd="56dp"
                android:paddingTop="20dp" android:paddingBottom="74dp"
                android:background="@drawable/bg_dash_banner"
                android:clipToOutline="true"
                android:elevation="5dp" android:outlineSpotShadowColor="@color/sage_shadow_spot" android:outlineAmbientShadowColor="@color/sage_shadow_ambient"
                android:layout_marginTop="22dp"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <ImageView android:src="@drawable/ic_crescent_small" android:tint="@color/sage_button"
                    android:importantForAccessibility="no" android:layout_marginBottom="8dp"
                    android:layout_width="22dp" android:layout_height="22dp"/>
                <TextView android:id="@+id/hadithText"
                    android:text="Loading reflection..."
                    android:fontFamily="serif"
                    android:textSize="14sp" android:textStyle="italic"
                    android:textColor="@color/sage_text" android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- bottomNav stays the transparent outer container (MainActivity adds the system-bar inset to it);
         navDock is the floating rounded pill, like the macOS Dock -->
    <LinearLayout android:id="@+id/bottomNav" android:orientation="horizontal"
        android:background="@android:color/transparent"
        android:clipChildren="false" android:clipToPadding="false"
        android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="8dp" android:paddingBottom="10dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:id="@+id/navDock" android:orientation="horizontal"
            android:background="@drawable/bg_nav_dock"
            android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp"
            android:elevation="12dp"
            android:outlineSpotShadowColor="@color/sage_shadow_spot" android:outlineAmbientShadowColor="@color/sage_shadow_ambient"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:id="@+id/navHome" android:orientation="vertical" android:gravity="center" android:padding="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackgroundBorderless"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                <ImageView android:src="@drawable/ic_dashboard" android:tint="@color/sage_text" android:importantForAccessibility="no" android:layout_width="24dp" android:layout_height="24dp"/>
                <TextView android:text="Home" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/sage_text" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/navCalculate" android:orientation="vertical" android:gravity="center" android:padding="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackgroundBorderless" android:alpha="0.8"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                <ImageView android:src="@drawable/ic_calculator" android:tint="@color/sage_text_soft" android:importantForAccessibility="no" android:layout_width="24dp" android:layout_height="24dp"/>
                <TextView android:text="Calculate" android:textSize="10sp" android:textStyle="normal" android:textColor="@color/sage_text_soft" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/navChat" android:orientation="vertical" android:gravity="center" android:padding="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackgroundBorderless" android:alpha="0.8"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                <FrameLayout android:layout_width="24dp" android:layout_height="24dp">
                    <ImageView android:src="@drawable/ic_chat" android:tint="@color/sage_text_soft" android:importantForAccessibility="no" android:layout_width="match_parent" android:layout_height="match_parent"/>
                    <View android:id="@+id/chatDot" android:background="@drawable/bg_red_dot" android:visibility="gone" android:layout_gravity="top|end" android:layout_marginTop="-2dp" android:layout_marginEnd="-2dp" android:layout_width="8dp" android:layout_height="8dp" android:elevation="5dp" android:outlineSpotShadowColor="@color/sage_shadow_spot" android:outlineAmbientShadowColor="@color/sage_shadow_ambient"/>
                </FrameLayout>
                <TextView android:text="Chat" android:textSize="10sp" android:textStyle="normal" android:textColor="@color/sage_text_soft" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/navSettings" android:orientation="vertical" android:gravity="center" android:padding="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackgroundBorderless" android:alpha="0.8"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                <ImageView android:src="@drawable/ic_settings" android:tint="@color/sage_text_soft" android:importantForAccessibility="no" android:layout_width="24dp" android:layout_height="24dp"/>
                <TextView android:text="Settings" android:textSize="10sp" android:textStyle="normal" android:textColor="@color/sage_text_soft" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
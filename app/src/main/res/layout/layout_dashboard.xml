<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_dash_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- THE MISSING ID: android:id="@+id/brandHeader" is back -->
    <FrameLayout
        android:id="@+id/brandHeader"
        android:paddingTop="42dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Decorative geometric ornament -->
        <ImageView
            android:src="@drawable/ic_pattern_star"
            android:alpha="0.8"
            android:layout_gravity="end|top"
            android:importantForAccessibility="no"
            android:layout_width="160dp"
            android:layout_height="120dp"/>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Row: three-bar menu + logo + name -->
            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageButton android:id="@+id/menuButton"
                    style="?android:attr/borderlessButtonStyle"
                    android:src="@drawable/ic_menu"
                    android:tint="@color/sage_text"
                    android:padding="14dp"
                    android:contentDescription="Menu"
                    android:layout_width="52dp"
                    android:layout_height="52dp"/>

                <FrameLayout android:id="@+id/logoContainer"
                    android:background="@drawable/bg_dash_logo_ring"
                    android:padding="2dp"
                    android:layout_marginStart="2dp"
                    android:layout_width="56dp"
                    android:layout_height="56dp">
                    <ImageView android:id="@+id/logoImage"
                        android:src="@drawable/logo"
                        android:scaleType="centerCrop"
                        android:importantForAccessibility="no"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </FrameLayout>

                <TextView android:text="CRESCENT"
                    android:fontFamily="serif"
                    android:textSize="30sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold"
                    android:textColor="@color/sage_text"
                    android:layout_marginStart="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Dates -->
            <LinearLayout
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:layout_marginTop="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView android:id="@+id/englishDateText"
                    android:text="—"
                    android:textSize="14sp"
                    android:textColor="@color/sage_text_soft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView android:id="@+id/arabicDateText"
                    android:text="—"
                    android:fontFamily="serif"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/sage_text"
                    android:layout_marginTop="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Main content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="false">
        <LinearLayout
            android:orientation="vertical"
            android:paddingStart="18dp" android:paddingEnd="18dp"
            android:paddingTop="6dp" android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Zakat Status card with Gauge -->
            <LinearLayout
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_dash_card"
                android:elevation="3dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView android:text="Zakat Status"
                    android:fontFamily="serif"
                    android:textSize="18sp" android:textStyle="bold"
                    android:textColor="@color/sage_text"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Gauge ring + text -->
                    <FrameLayout android:layout_width="124dp" android:layout_height="124dp">
                        <com.crescent.app.GaugeView android:id="@+id/zakatGauge"
                            android:layout_width="match_parent" android:layout_height="match_parent"/>
                        <LinearLayout
                            android:orientation="vertical" android:gravity="center"
                            android:paddingStart="14dp" android:paddingEnd="14dp"
                            android:layout_gravity="center"
                            android:layout_width="match_parent" android:layout_height="match_parent">
                            <TextView android:id="@+id/zakatYearText"
                                android:text="Your Zakat" android:textSize="10sp"
                                android:textColor="@color/sage_text_soft" android:gravity="center"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:id="@+id/zakatAmountCircle"
                                android:text="0 BDT" android:textSize="17sp" android:textStyle="bold"
                                android:textColor="@color/sage_text" android:gravity="center"
                                android:maxLines="1"
                                android:layout_marginTop="2dp" android:layout_marginBottom="2dp"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:id="@+id/zakatStateText"
                                android:text="Not calculated" android:textSize="10sp"
                                android:textColor="@color/sage_text_soft"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </FrameLayout>

                    <!-- Actions -->
                    <LinearLayout
                        android:orientation="vertical" android:gravity="center_horizontal"
                        android:layout_marginStart="14dp"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                        <TextView android:id="@+id/payNowBtn"
                            android:text="Pay Now" android:textSize="15sp" android:textStyle="bold"
                            android:textColor="#FFFFFF" android:gravity="center"
                            android:background="@drawable/bg_dash_btn"
                            android:clickable="true" android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:minHeight="44dp"
                            android:layout_width="match_parent" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/detailedBreakdownBtn"
                            android:text="Detailed Breakdown" android:textSize="12sp" android:textStyle="bold"
                            android:textColor="@color/sage_text"
                            android:paddingTop="10dp" android:paddingBottom="10dp"
                            android:layout_marginTop="6dp"
                            android:clickable="true" android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 2x2 options -->
            <LinearLayout android:orientation="horizontal" android:layout_marginTop="16dp"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:id="@+id/gridCalculate"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="16dp" android:paddingBottom="16dp"
                    android:background="@drawable/bg_dash_card" android:elevation="2dp" android:layout_marginEnd="6dp"
                    android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                    <TextView android:text="Calculate\nZakat" android:textSize="14sp" android:textStyle="bold"
                        android:textColor="@color/sage_text" android:lineSpacingExtra="1dp"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                    <ImageView android:src="@drawable/ic_calculator" android:tint="@color/sage_text_soft"
                        android:importantForAccessibility="no" android:layout_width="30dp" android:layout_height="30dp"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/gridAssets"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="16dp" android:paddingBottom="16dp"
                    android:background="@drawable/bg_dash_card" android:elevation="2dp" android:layout_marginStart="6dp"
                    android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                    <TextView android:text="Asset\nBreakdown" android:textSize="14sp" android:textStyle="bold"
                        android:textColor="@color/sage_text" android:lineSpacingExtra="1dp"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                    <ImageView android:src="@drawable/ic_pie" android:tint="@color/sage_text_soft"
                        android:importantForAccessibility="no" android:layout_width="30dp" android:layout_height="30dp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:orientation="horizontal" android:layout_marginTop="12dp"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:id="@+id/gridHistory"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="16dp" android:paddingBottom="16dp"
                    android:background="@drawable/bg_dash_card" android:elevation="2dp" android:layout_marginEnd="6dp"
                    android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                    <TextView android:text="Zakat\nHistory" android:textSize="14sp" android:textStyle="bold"
                        android:textColor="@color/sage_text" android:lineSpacingExtra="1dp"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                    <ImageView android:src="@drawable/ic_history" android:tint="@color/sage_text_soft"
                        android:importantForAccessibility="no" android:layout_width="30dp" android:layout_height="30dp"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/gridChat"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="16dp" android:paddingBottom="16dp"
                    android:background="@drawable/bg_dash_card" android:elevation="2dp" android:layout_marginStart="6dp"
                    android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                    <TextView android:text="Chat with\nExpert" android:textSize="14sp" android:textStyle="bold"
                        android:textColor="@color/sage_text" android:lineSpacingExtra="1dp"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                    <ImageView android:src="@drawable/ic_chat" android:tint="@color/sage_text_soft"
                        android:importantForAccessibility="no" android:layout_width="30dp" android:layout_height="30dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Hadith / ayah banner -->
            <LinearLayout
                android:orientation="vertical" android:gravity="center"
                android:paddingStart="22dp" android:paddingEnd="22dp"
                android:paddingTop="20dp" android:paddingBottom="22dp"
                android:background="@drawable/bg_dash_banner"
                android:elevation="2dp"
                android:layout_marginTop="22dp"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <ImageView android:src="@drawable/ic_crescent_small" android:tint="@color/sage_button"
                    android:importantForAccessibility="no" android:layout_marginBottom="8dp"
                    android:layout_width="22dp" android:layout_height="22dp"/>
                <TextView android:id="@+id/hadithText"
                    android:text="Loading reflection..."
                    android:fontFamily="serif"
                    android:textSize="14sp" android:textStyle="italic"
                    android:textColor="@color/sage_text" android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom navigation -->
    <View android:background="@color/sage_card_stroke" android:layout_width="match_parent" android:layout_height="1dp"/>
    <LinearLayout android:id="@+id/bottomNav" android:orientation="horizontal"
        android:background="@color/sage_card"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:id="@+id/navHome" android:orientation="vertical" android:gravity="center" android:padding="6dp"
            android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
            <ImageView android:src="@drawable/ic_dashboard" android:tint="@color/sage_text" android:importantForAccessibility="no" android:layout_width="24dp" android:layout_height="24dp"/>
            <TextView android:text="Home" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/sage_text" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navCalculate" android:orientation="vertical" android:gravity="center" android:padding="6dp"
            android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:alpha="0.8"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
            <ImageView android:src="@drawable/ic_calculator" android:tint="@color/sage_text_soft" android:importantForAccessibility="no" android:layout_width="24dp" android:layout_height="24dp"/>
            <TextView android:text="Calculate" android:textSize="10sp" android:textStyle="normal" android:textColor="@color/sage_text_soft" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navChat" android:orientation="vertical" android:gravity="center" android:padding="6dp"
            android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:alpha="0.8"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
            <ImageView android:src="@drawable/ic_chat" android:tint="@color/sage_text_soft" android:importantForAccessibility="no" android:layout_width="24dp" android:layout_height="24dp"/>
            <TextView android:text="Chat" android:textSize="10sp" android:textStyle="normal" android:textColor="@color/sage_text_soft" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navSettings" android:orientation="vertical" android:gravity="center" android:padding="6dp"
            android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:alpha="0.8"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
            <ImageView android:src="@drawable/ic_settings" android:tint="@color/sage_text_soft" android:importantForAccessibility="no" android:layout_width="24dp" android:layout_height="24dp"/>
            <TextView android:text="Settings" android:textSize="10sp" android:textStyle="normal" android:textColor="@color/sage_text_soft" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
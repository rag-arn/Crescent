<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="24dp" android:background="@drawable/bg_dash_card"
    android:layout_width="match_parent" android:layout_height="wrap_content">

    <TextView android:id="@+id/themedTitle" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/sage_text"
        android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/themedMessage" android:textSize="14sp" android:textColor="@color/sage_text_soft" android:lineSpacingExtra="4dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </ScrollView>

    <EditText android:id="@+id/themedInput" style="@style/Widget.Crescent.EditText" android:visibility="gone"
        android:maxLines="1" android:singleLine="true" android:layout_marginTop="16dp"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <TextView android:id="@+id/themedError" android:visibility="gone" android:textSize="12sp" android:textColor="#C9605A"
        android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <LinearLayout android:orientation="horizontal" android:layout_marginTop="24dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/themedNegative" style="@style/Widget.Crescent.Button.Outlined" android:visibility="gone"
            android:layout_marginEnd="6dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <Button android:id="@+id/themedPositive" style="@style/Widget.Crescent.Button"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
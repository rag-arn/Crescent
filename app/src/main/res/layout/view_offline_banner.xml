<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp"
    android:background="@drawable/bg_offline_banner" android:accessibilityLiveRegion="polite"
    android:layout_width="match_parent" android:layout_height="wrap_content">

    <ImageView android:id="@+id/bannerIcon" android:src="@drawable/ic_airplane" android:tint="@color/sage_text"
        android:importantForAccessibility="no" android:layout_width="22dp" android:layout_height="22dp"/>

    <LinearLayout android:orientation="vertical" android:layout_marginStart="12dp"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
        <TextView android:id="@+id/bannerTitle" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/sage_text"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/bannerMessage" android:textSize="12sp" android:textColor="@color/sage_text_soft" android:lineSpacingExtra="2dp"
            android:layout_marginTop="2dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:background="@drawable/bg_dash_screen"
    android:padding="32dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Packed Vertical Chain keeps these 3 elements centered as a group -->
    <FrameLayout
        android:id="@+id/logoFrame"
        android:background="@drawable/bg_dash_logo_ring"
        android:padding="4dp"
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/brandTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/logoImage"
            android:src="@drawable/logo"
            android:scaleType="centerCrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>

    <TextView
        android:id="@+id/brandTitle"
        android:text="CRESCENT"
        android:fontFamily="serif"
        android:textSize="28sp"
        android:letterSpacing="0.08"
        android:textStyle="bold"
        android:textColor="@color/sage_text"
        android:layout_marginTop="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/logoFrame"
        app:layout_constraintBottom_toTopOf="@+id/authCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/authCard"
        android:padding="24dp"
        android:background="@drawable/bg_dash_card"
        android:elevation="6dp"
        android:outlineSpotShadowColor="@color/sage_shadow_spot"
        android:outlineAmbientShadowColor="@color/sage_shadow_ambient"
        android:layout_marginTop="32dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/brandTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/authTitle"
            android:text="Sign In"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/sage_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- NEW: Name Input (Hidden in Login Mode) -->
        <EditText
            android:id="@+id/nameInput"
            style="@style/Widget.Crescent.EditText"
            android:hint="Full Name"
            android:inputType="textPersonName"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/authTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <EditText
            android:id="@+id/emailInput"
            style="@style/Widget.Crescent.EditText"
            android:hint="Email address"
            android:inputType="textEmailAddress"
            android:layout_marginTop="8dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/nameInput"
            app:layout_goneMarginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- MODIFIED: Password Input Wrapper -->
        <LinearLayout
            android:id="@+id/passwordWrapper"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/emailInput"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <EditText
                android:id="@+id/passwordInput"
                android:hint="Password"
                android:inputType="textPassword"
                android:background="@null"
                android:textColor="@color/sage_text"
                android:textColorHint="@color/sage_text_soft"
                android:textSize="15sp"
                android:padding="12dp"
                android:minHeight="48dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/togglePasswordText"
                android:text="SHOW"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/sage_text_soft"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- NEW: Confirm Password Wrapper (Hidden in Login Mode) -->
        <LinearLayout
            android:id="@+id/confirmPasswordWrapper"
            android:visibility="gone"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/passwordWrapper"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <EditText
                android:id="@+id/confirmPasswordInput"
                android:hint="Confirm Password"
                android:inputType="textPassword"
                android:background="@null"
                android:textColor="@color/sage_text"
                android:textColorHint="@color/sage_text_soft"
                android:textSize="15sp"
                android:padding="12dp"
                android:minHeight="48dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/toggleConfirmPasswordText"
                android:text="SHOW"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/sage_text_soft"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Wrong-password message (red), shown on the same row as "Forgot password?" -->
        <TextView
            android:id="@+id/passwordErrorText"
            android:text="Incorrect password"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#E53935"
            android:visibility="gone"
            android:padding="8dp"
            android:layout_marginTop="2dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/passwordWrapper"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/forgotPasswordText"
            app:layout_constraintHorizontal_bias="0"/>

        <!-- Forgot password (Sign In mode only) -->
        <TextView
            android:id="@+id/forgotPasswordText"
            android:text="Forgot password?"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/sage_text_soft"
            android:padding="8dp"
            android:layout_marginTop="2dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/passwordWrapper"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Bottom edge of whichever form fields are visible -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/formBottomBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:barrierAllowsGoneWidgets="false"
            app:constraint_referenced_ids="passwordWrapper,confirmPasswordWrapper,forgotPasswordText,passwordErrorText"/>

        <Button
            android:id="@+id/authActionBtn"
            style="@style/Widget.Crescent.Button"
            android:text="Sign In"
            android:layout_marginTop="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/formBottomBarrier"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/toggleAuthModeText"
            android:text="Don't have an account? Sign Up"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/sage_text_soft"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/authActionBtn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/orSeparator"
            android:text="— OR —"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/sage_text_soft"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/toggleAuthModeText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Button
            android:id="@+id/googleSignInBtn"
            style="@style/Widget.Crescent.Button.Outlined"
            android:text="Continue with Google"
            android:layout_marginTop="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/orSeparator"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Button
            android:id="@+id/guestBtn"
            style="@style/Widget.Crescent.Button.Text"
            android:text="Continue as Guest"
            android:layout_marginTop="8dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/googleSignInBtn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <ProgressBar
            android:id="@+id/loginProgress"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/guestBtn"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
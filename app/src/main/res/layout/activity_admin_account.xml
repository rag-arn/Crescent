<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout" android:orientation="vertical"
    android:background="@drawable/bg_dash_screen_soft"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <FrameLayout android:id="@+id/headerBar" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="10dp" android:paddingTop="42dp" android:paddingBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <ImageButton android:id="@+id/backButton" style="?android:attr/borderlessButtonStyle" android:src="@drawable/ic_back_arrow" android:tint="@color/sage_text" android:layout_marginEnd="12dp" android:layout_width="44dp" android:layout_height="44dp"/>
            <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                <TextView android:text="Admin" android:textSize="11sp" android:textStyle="bold" android:textAllCaps="true" android:letterSpacing="0.1" android:textColor="@color/sage_text_soft" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Admin Account" android:fontFamily="serif" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/sage_text" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">

            <!-- Email -->
            <LinearLayout android:orientation="vertical" android:padding="18dp"
                android:background="@drawable/bg_dash_card" android:elevation="4dp" android:outlineSpotShadowColor="@color/sage_shadow_spot" android:outlineAmbientShadowColor="@color/sage_shadow_ambient"
                android:layout_marginBottom="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:text="Change e-mail" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/sage_text" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/currentEmailText" android:textSize="13sp" android:textColor="@color/sage_text_soft" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="A verification link is sent to the NEW address. The e-mail only changes after you tap that link." android:textSize="12sp" android:textColor="@color/sage_text_soft" android:layout_marginTop="8dp" android:layout_marginBottom="14dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

                <EditText android:id="@+id/newEmailInput" style="@style/Widget.Crescent.EditText" android:hint="New e-mail address" android:inputType="textEmailAddress" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <EditText android:id="@+id/currentPasswordInput" style="@style/Widget.Crescent.EditText" android:hint="Current password" android:inputType="textPassword" android:singleLine="true" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <Button android:id="@+id/changeEmailBtn" style="@style/Widget.Crescent.Button" android:text="Send verification link" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Password -->
            <LinearLayout android:orientation="vertical" android:padding="18dp"
                android:background="@drawable/bg_dash_card" android:elevation="4dp" android:outlineSpotShadowColor="@color/sage_shadow_spot" android:outlineAmbientShadowColor="@color/sage_shadow_ambient"
                android:layout_marginBottom="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:text="Change password" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/sage_text" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="We e-mail a secure link to your current address. Open it to choose a new password." android:textSize="12sp" android:textColor="@color/sage_text_soft" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <Button android:id="@+id/changePasswordBtn" style="@style/Widget.Crescent.Button.Outlined" android:text="E-mail me a password link" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>

            <ProgressBar android:id="@+id/accountProgress" android:visibility="gone" android:layout_gravity="center_horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

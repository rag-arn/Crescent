<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout" android:orientation="vertical"
    android:background="@drawable/bg_dash_screen_soft"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <FrameLayout android:id="@+id/headerBar" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="42dp" android:paddingBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="Administrator" android:textSize="11sp" android:textStyle="bold" android:textAllCaps="true" android:letterSpacing="0.1" android:textColor="@color/sage_text_soft" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="Admin Dashboard" android:fontFamily="serif" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/sage_text" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/adminEmailText" android:textSize="12sp" android:textColor="@color/sage_text_soft" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
    </FrameLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">

            <LinearLayout android:id="@+id/cardApplications" android:orientation="horizontal" android:padding="18dp" android:gravity="center_vertical"
                android:background="@drawable/bg_dash_card" android:elevation="4dp" android:outlineSpotShadowColor="@color/sage_shadow_spot" android:outlineAmbientShadowColor="@color/sage_shadow_ambient"
                android:layout_marginBottom="14dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <ImageView android:src="@drawable/ic_person" android:tint="@color/sage_text" android:layout_marginEnd="16dp" android:layout_width="30dp" android:layout_height="30dp"/>
                <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                    <TextView android:text="Expert applications" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/sage_text" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Approve or reject people who applied to become experts." android:textSize="12sp" android:textColor="@color/sage_text_soft" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/pendingCountText" android:textSize="12sp" android:textStyle="bold" android:textColor="#F57F17" android:layout_marginTop="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/cardRatings" android:orientation="horizontal" android:padding="18dp" android:gravity="center_vertical"
                android:background="@drawable/bg_dash_card" android:elevation="4dp" android:outlineSpotShadowColor="@color/sage_shadow_spot" android:outlineAmbientShadowColor="@color/sage_shadow_ambient"
                android:layout_marginBottom="14dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <ImageView android:src="@drawable/ic_gem" android:tint="@color/sage_text" android:layout_marginEnd="16dp" android:layout_width="30dp" android:layout_height="30dp"/>
                <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                    <TextView android:text="Expert ratings" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/sage_text" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="See each expert's ratings and who gave them." android:textSize="12sp" android:textColor="@color/sage_text_soft" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/cardNotify" android:orientation="horizontal" android:padding="18dp" android:gravity="center_vertical"
                android:background="@drawable/bg_dash_card" android:elevation="4dp" android:outlineSpotShadowColor="@color/sage_shadow_spot" android:outlineAmbientShadowColor="@color/sage_shadow_ambient"
                android:layout_marginBottom="14dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <ImageView android:src="@drawable/ic_bell" android:tint="@color/sage_text" android:layout_marginEnd="16dp" android:layout_width="30dp" android:layout_height="30dp"/>
                <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                    <TextView android:text="Send notification" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/sage_text" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Send a message to every user of the app." android:textSize="12sp" android:textColor="@color/sage_text_soft" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>


            <LinearLayout android:id="@+id/cardUsers" android:orientation="horizontal" android:padding="18dp" android:gravity="center_vertical"
                android:background="@drawable/bg_dash_card" android:elevation="4dp" android:outlineSpotShadowColor="@color/sage_shadow_spot" android:outlineAmbientShadowColor="@color/sage_shadow_ambient"
                android:layout_marginBottom="14dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <ImageView android:src="@drawable/ic_person" android:tint="@color/sage_text" android:layout_marginEnd="16dp" android:layout_width="30dp" android:layout_height="30dp"/>
                <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                    <TextView android:text="Manage users" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/sage_text" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Disable an account or delete a user's data." android:textSize="12sp" android:textColor="@color/sage_text_soft" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/cardAccount" android:orientation="horizontal" android:padding="18dp" android:gravity="center_vertical"
                android:background="@drawable/bg_dash_card" android:elevation="4dp" android:outlineSpotShadowColor="@color/sage_shadow_spot" android:outlineAmbientShadowColor="@color/sage_shadow_ambient"
                android:layout_marginBottom="24dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <ImageView android:src="@drawable/ic_settings" android:tint="@color/sage_text" android:layout_marginEnd="16dp" android:layout_width="30dp" android:layout_height="30dp"/>
                <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                    <TextView android:text="Admin account" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/sage_text" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Change the admin e-mail or password (needs e-mail verification)." android:textSize="12sp" android:textColor="@color/sage_text_soft" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

            <Button android:id="@+id/adminSignOutBtn" style="@style/Widget.Crescent.Button.Outlined" android:text="Sign out" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:orientation="vertical"
    android:background="@drawable/bg_dash_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout android:id="@+id/headerBar" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="16dp" android:paddingTop="14dp" android:paddingBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <ImageButton android:id="@+id/backButton" style="?android:attr/borderlessButtonStyle" android:src="@drawable/ic_back_arrow" android:tint="@color/sage_text" android:contentDescription="Back" android:layout_marginEnd="12dp" android:layout_width="44dp" android:layout_height="44dp"/>
            <TextView android:text="Asset Breakdown" android:fontFamily="serif" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/sage_text" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
    </FrameLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false">
        <LinearLayout android:orientation="vertical" android:padding="18dp" android:layout_width="match_parent" android:layout_height="wrap_content">

            <TextView android:id="@+id/statusText" android:textSize="13sp" android:textColor="@color/sage_text_soft" android:lineSpacingExtra="3dp" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:id="@+id/cardCash" android:orientation="vertical" android:padding="16dp" android:minHeight="116dp" android:background="@drawable/bg_dash_card" android:elevation="4dp" android:outlineSpotShadowColor="@color/sage_shadow_spot" android:outlineAmbientShadowColor="@color/sage_shadow_ambient" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="6dp">
                    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:text="Cash &amp; Savings" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/sage_text_soft" android:maxLines="1" android:ellipsize="end" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                        <ImageView android:src="@drawable/ic_wallet" android:tint="@color/amber_gold" android:importantForAccessibility="no" android:layout_marginStart="6dp" android:layout_width="24dp" android:layout_height="24dp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/cashAmount" android:text="৳0" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/sage_text" android:maxLines="1" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/cashSub" android:text="" android:textSize="12sp" android:textColor="@color/sage_text_soft" android:maxLines="1" android:layout_marginTop="2dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/cardGold" android:orientation="vertical" android:padding="16dp" android:minHeight="116dp" android:background="@drawable/bg_dash_card" android:elevation="4dp" android:outlineSpotShadowColor="@color/sage_shadow_spot" android:outlineAmbientShadowColor="@color/sage_shadow_ambient" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="6dp">
                    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:text="Gold &amp; Silver" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/sage_text_soft" android:maxLines="1" android:ellipsize="end" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                        <ImageView android:src="@drawable/ic_gem" android:tint="@color/amber_gold" android:importantForAccessibility="no" android:layout_marginStart="6dp" android:layout_width="24dp" android:layout_height="24dp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/goldAmount" android:text="৳0" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/sage_text" android:maxLines="1" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/goldSub" android:text="" android:textSize="12sp" android:textColor="@color/sage_text_soft" android:maxLines="1" android:layout_marginTop="2dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:orientation="horizontal" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:id="@+id/cardCommercial" android:orientation="vertical" android:padding="16dp" android:minHeight="116dp" android:background="@drawable/bg_dash_card" android:elevation="4dp" android:outlineSpotShadowColor="@color/sage_shadow_spot" android:outlineAmbientShadowColor="@color/sage_shadow_ambient" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="6dp">
                    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:text="Commercial Goods" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/sage_text_soft" android:maxLines="1" android:ellipsize="end" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                        <ImageView android:src="@drawable/ic_bag" android:tint="@color/amber_gold" android:importantForAccessibility="no" android:layout_marginStart="6dp" android:layout_width="24dp" android:layout_height="24dp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/commercialAmount" android:text="৳0" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/sage_text" android:maxLines="1" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/commercialSub" android:text="" android:textSize="12sp" android:textColor="@color/sage_text_soft" android:maxLines="1" android:layout_marginTop="2dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/cardLiabilities" android:orientation="vertical" android:padding="16dp" android:minHeight="116dp" android:background="@drawable/bg_dash_card" android:elevation="4dp" android:outlineSpotShadowColor="@color/sage_shadow_spot" android:outlineAmbientShadowColor="@color/sage_shadow_ambient" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="6dp">
                    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:text="Liabilities" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/sage_text_soft" android:maxLines="1" android:ellipsize="end" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                        <ImageView android:src="@drawable/ic_arrow_down_right" android:tint="@color/amber_gold" android:importantForAccessibility="no" android:layout_marginStart="6dp" android:layout_width="24dp" android:layout_height="24dp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/liabilitiesAmount" android:text="৳0" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/sage_text" android:maxLines="1" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/liabilitiesSub" android:text="" android:textSize="12sp" android:textColor="@color/sage_text_soft" android:maxLines="1" android:layout_marginTop="2dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="24dp" android:background="@drawable/bg_dash_card"
    android:layout_width="match_parent" android:layout_height="wrap_content">

    <TextView android:id="@+id/rateTitleText" android:text="Rate Expert" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/sage_text" android:layout_marginBottom="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <TextView android:text="How was your consultation? Your feedback helps keep the community reliable." android:textSize="14sp" android:textColor="@color/sage_text_soft" android:lineSpacingExtra="4dp" android:layout_marginBottom="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <RatingBar android:id="@+id/ratingBar"
        style="?android:attr/ratingBarStyle"
        android:stepSize="1.0"
        android:numStars="5"
        android:progressTint="@color/amber_gold"
        android:secondaryProgressTint="@android:color/transparent"
        android:progressBackgroundTint="#4D5B7B7A"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/skipBtn" style="@style/Widget.Crescent.Button.Outlined" android:text="Skip" android:layout_marginEnd="6dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <Button android:id="@+id/submitBtn" style="@style/Widget.Crescent.Button" android:text="Submit" android:layout_marginStart="6dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
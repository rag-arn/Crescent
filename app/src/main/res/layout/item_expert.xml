<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal" android:padding="16dp"
    android:background="@drawable/bg_dash_card" android:elevation="4dp" android:outlineSpotShadowColor="@color/sage_shadow_spot" android:outlineAmbientShadowColor="@color/sage_shadow_ambient"
    android:layout_marginBottom="12dp" android:gravity="center_vertical"
    android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
    android:layout_width="match_parent" android:layout_height="wrap_content">

    <FrameLayout android:background="@drawable/bg_dash_logo_ring" android:layout_width="48dp" android:layout_height="48dp">
        <!-- ADDED ID HERE -->
        <ImageView android:id="@+id/expertImage" android:src="@drawable/ic_person" android:tint="@color/sage_text" android:padding="10dp" android:scaleType="centerCrop" android:layout_width="match_parent" android:layout_height="match_parent"/>
    </FrameLayout>

    <LinearLayout android:orientation="vertical" android:layout_marginStart="16dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
        <TextView android:id="@+id/expertName" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/sage_text" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/expertBio" android:textSize="12sp" android:textColor="@color/sage_text_soft" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/expertRating" android:textSize="12sp" android:textStyle="bold" android:textColor="#F57F17" android:layout_marginTop="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:background="@drawable/bg_dash_screen"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <FrameLayout android:id="@+id/headerBar" android:layout_width="match_parent" android:layout_height="wrap_content">
        <ImageView android:src="@drawable/ic_pattern_star" android:alpha="0.8" android:layout_gravity="end|top" android:importantForAccessibility="no" android:layout_width="160dp" android:layout_height="120dp"/>
        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="10dp" android:paddingTop="14dp" android:paddingBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                <TextView android:text="Step 5 of 5" android:textSize="11sp" android:textStyle="bold" android:textAllCaps="true" android:letterSpacing="0.1" android:textColor="@color/sage_text_soft" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Nisab" android:fontFamily="serif" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/sage_text" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
            <ImageButton android:id="@+id/infoButton" style="?android:attr/borderlessButtonStyle" android:src="@drawable/ic_info" android:tint="@color/sage_text_soft" android:padding="10dp" android:layout_width="44dp" android:layout_height="44dp"/>
        </LinearLayout>
    </FrameLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="Choose the Nisab basis" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/sage_text" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <RadioGroup android:id="@+id/nisabGroup" android:layout_width="match_parent" android:layout_height="wrap_content">
                <RadioButton android:id="@+id/goldOption" android:background="@drawable/bg_asset_card" android:padding="16dp"
                    android:textSize="15sp" android:textColor="@color/sage_text" android:buttonTint="@color/sage_text_soft"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <RadioButton android:id="@+id/silverOption" android:background="@drawable/bg_asset_card" android:padding="16dp"
                    android:textSize="15sp" android:textColor="@color/sage_text" android:buttonTint="@color/sage_text_soft" android:layout_marginTop="12dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </RadioGroup>
        </LinearLayout>
    </ScrollView>
    <View android:background="@color/sage_card_stroke" android:layout_width="match_parent" android:layout_height="1dp"/>
    <LinearLayout android:id="@+id/bottomBar" android:orientation="horizontal" android:background="@color/sage_card" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/previousButton" style="@style/Widget.Crescent.Button.Outlined" android:text="Previous" android:layout_marginEnd="6dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <Button android:id="@+id/calculateButton" style="@style/Widget.Crescent.Button" android:text="Calculate" android:layout_marginStart="6dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
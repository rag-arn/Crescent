<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:orientation="vertical"
    android:background="@drawable/bg_dash_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

 <FrameLayout android:id="@+id/headerBar" android:layout_width="match_parent" android:layout_height="wrap_content">
  <ImageView android:src="@drawable/ic_pattern_star" android:alpha="0.8" android:layout_gravity="end|top" android:importantForAccessibility="no" android:layout_width="160dp" android:layout_height="120dp"/>
  <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="10dp" android:paddingTop="14dp" android:paddingBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
   <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
    <TextView android:text="Saved calculations" android:textSize="11sp" android:textStyle="bold" android:textAllCaps="true" android:letterSpacing="0.1" android:textColor="@color/sage_text_soft" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:text="History" android:fontFamily="serif" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/sage_text" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
   </LinearLayout>
  </LinearLayout>
 </FrameLayout>

 <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <ListView android:id="@+id/historyList" android:divider="@android:color/transparent" android:dividerHeight="10dp" android:padding="16dp" android:clipToPadding="false" android:scrollbars="vertical" android:layout_width="match_parent" android:layout_height="match_parent"/>

  <LinearLayout android:id="@+id/emptyCard" android:orientation="vertical" android:padding="16dp" android:layout_margin="16dp" android:background="@drawable/bg_asset_card" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content">
   <TextView android:id="@+id/historyText" android:text="No snapshots saved yet. Complete a Zakat calculation to save one." android:textSize="15sp" android:textColor="@color/sage_text" android:lineSpacingExtra="3dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  </LinearLayout>
 </FrameLayout>
</LinearLayout>
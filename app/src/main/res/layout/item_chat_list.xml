<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="16dp"
    android:background="@drawable/bg_dash_card"
    android:elevation="4dp"
    android:outlineSpotShadowColor="@color/sage_shadow_spot"
    android:outlineAmbientShadowColor="@color/sage_shadow_ambient"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <FrameLayout
        android:id="@+id/inboxImageFrame"
        android:background="@drawable/bg_dash_logo_ring"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_width="52dp"
        android:layout_height="52dp">

        <ImageView
            android:id="@+id/inboxImage"
            android:src="@drawable/ic_person"
            android:tint="@color/sage_text"
            android:padding="12dp"
            android:scaleType="centerCrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>

    <!-- Right Side Container (Anchored to the end) -->
    <LinearLayout
        android:id="@+id/inboxRightSide"
        android:orientation="vertical"
        android:gravity="end"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/inboxTime"
            android:textSize="11sp"
            android:textColor="@color/sage_text_soft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <View
            android:id="@+id/inboxUnreadDot"
            android:background="@drawable/bg_red_dot"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            android:layout_width="12dp"
            android:layout_height="12dp"/>
    </LinearLayout>

    <!-- Middle Text Container (Fills space between the image and right container) -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_toEndOf="@id/inboxImageFrame"
        android:layout_toStartOf="@id/inboxRightSide"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/inboxName"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/sage_text"
            android:maxLines="1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/inboxMessage"
            android:textSize="13sp"
            android:textColor="@color/sage_text_soft"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

</RelativeLayout>
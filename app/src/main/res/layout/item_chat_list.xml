<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal" android:padding="16dp"
    android:background="@drawable/bg_dash_card" android:elevation="2dp"
    android:layout_marginBottom="12dp" android:gravity="center_vertical"
    android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
    android:layout_width="match_parent" android:layout_height="wrap_content">

    <FrameLayout android:background="@drawable/bg_dash_logo_ring" android:layout_width="52dp" android:layout_height="52dp">
        <ImageView android:id="@+id/inboxImage" android:src="@drawable/ic_person" android:tint="@color/sage_text" android:padding="12dp" android:scaleType="centerCrop" android:layout_width="match_parent" android:layout_height="match_parent"/>
    </FrameLayout>

    <LinearLayout android:orientation="vertical" android:layout_marginStart="16dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
        <TextView android:id="@+id/inboxName" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/sage_text" android:maxLines="1" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/inboxMessage" android:textSize="13sp" android:textColor="@color/sage_text_soft" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout android:orientation="vertical" android:gravity="end" android:layout_marginStart="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <TextView android:id="@+id/inboxTime" android:textSize="11sp" android:textColor="@color/sage_text_soft" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <View android:id="@+id/inboxUnreadDot" android:background="@drawable/bg_red_dot" android:visibility="gone" android:layout_marginTop="8dp" android:layout_width="12dp" android:layout_height="12dp"/>
    </LinearLayout>
</LinearLayout>
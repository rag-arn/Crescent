<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F5F7F4">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:text="☾ Crescent" android:textColor="#176B52" android:textSize="32sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="Your wealth. Your responsibility. Your records." android:textColor="#52645C" android:textSize="15sp" android:layout_marginTop="8dp" android:layout_marginBottom="28dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp">
            <LinearLayout android:padding="20dp" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:text="Zakat Calculator" android:textSize="20sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <TextView android:text="Enter assets and liabilities to estimate your Zakat." android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <Button android:id="@+id/btnCalculator" android:text="Calculate Zakat" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp">
            <LinearLayout android:padding="20dp" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:text="History" android:textSize="20sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <TextView android:text="Review saved yearly snapshots." android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <Button android:id="@+id/btnHistory" android:text="View History" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:padding="20dp" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:text="About Zakat" android:textSize="20sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <TextView android:text="Learn about Nisab, calculation, and important considerations." android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <Button android:id="@+id/btnInfo" android:text="Read Information" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:orientation="vertical" android:padding="20dp"
            android:layout_width="match_parent" android:layout_height="wrap_content">

            <TextView android:text="Step 5 of 5" android:textSize="13sp" android:textColor="#176B52"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:text="Nisab" android:textSize="28sp" android:textStyle="bold" android:textColor="#176B52"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                <ImageButton android:id="@+id/infoButton" style="?android:attr/borderlessButtonStyle"
                    android:src="@android:drawable/ic_dialog_info" android:tint="#176B52"
                    android:contentDescription="About Nisab"
                    android:layout_width="44dp" android:layout_height="44dp"/>
            </LinearLayout>

            <TextView android:text="Choose the Nisab basis:" android:textStyle="bold"
                android:layout_marginTop="12dp" android:layout_marginBottom="4dp"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>

            <RadioGroup android:id="@+id/nisabGroup" android:layout_width="match_parent" android:layout_height="wrap_content">
                <RadioButton android:id="@+id/goldOption" android:textSize="16sp" android:padding="8dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <RadioButton android:id="@+id/silverOption" android:textSize="16sp" android:padding="8dp" android:layout_marginTop="8dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </RadioGroup>
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:orientation="horizontal" android:padding="12dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/previousButton" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:text="Previous" android:layout_marginEnd="6dp"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <Button android:id="@+id/calculateButton" android:text="Calculate" android:layout_marginStart="6dp"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
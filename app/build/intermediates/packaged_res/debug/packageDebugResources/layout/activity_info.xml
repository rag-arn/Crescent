<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:orientation="vertical" android:background="@drawable/bg_dash_screen"
    android:layout_width="match_parent" android:layout_height="match_parent">

 <FrameLayout android:id="@+id/headerBar" android:layout_width="match_parent" android:layout_height="wrap_content">
  <ImageView android:src="@drawable/ic_pattern_star" android:alpha="0.8" android:layout_gravity="end|top" android:importantForAccessibility="no" android:layout_width="160dp" android:layout_height="120dp"/>
  <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="10dp" android:paddingTop="14dp" android:paddingBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
   <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
    <TextView android:text="Learn" android:textSize="11sp" android:textStyle="bold" android:textAllCaps="true" android:letterSpacing="0.1" android:textColor="@color/sage_text_soft" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:text="About Zakat" android:fontFamily="serif" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/sage_text" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
   </LinearLayout>
  </LinearLayout>
 </FrameLayout>

 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
   <LinearLayout android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_asset_card" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:text="Zakat is an obligatory form of giving in Islam for eligible wealth. Commonly, the basic estimate is 2.5% of eligible net zakatable wealth when it reaches the Nisab threshold and applicable conditions (including the lunar-year condition, where relevant) are met. The treatment of assets can differ by scholarly opinion and personal circumstances." android:textSize="15sp" android:lineSpacingExtra="4dp" android:textColor="@color/sage_text" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   </LinearLayout>
   <LinearLayout android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_asset_card" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:text="In this app, Nisab is the value of 87.48 grams of gold (7.5 bhori) or 612.36 grams of silver (52.5 bhori), whichever you choose as the basis. The threshold is calculated from the gold or silver price you use in the app, which you can edit. Scholars differ on which basis to follow, so use the one recommended by the scholar or method you follow." android:textSize="15sp" android:lineSpacingExtra="4dp" android:textColor="@color/sage_text" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   </LinearLayout>
   <LinearLayout android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_asset_card" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:text="This app is an educational estimate, not a religious ruling or financial advice. Gold jewellery, debts, pensions, property, business assets, and receivables may require individual assessment. Please consult a qualified scholar or Zakat expert." android:textSize="15sp" android:lineSpacingExtra="4dp" android:textColor="#B71C1C" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   </LinearLayout>
  </LinearLayout>
 </ScrollView>
</LinearLayout>
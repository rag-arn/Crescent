<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:background="@drawable/bg_dash_screen"
    android:layout_width="match_parent" android:layout_height="match_parent">

 <FrameLayout android:id="@+id/headerBar" android:layout_width="match_parent" android:layout_height="wrap_content">
  <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="10dp" android:paddingTop="14dp" android:paddingBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
   <ImageButton android:id="@+id/backButton" style="?android:attr/borderlessButtonStyle" android:src="@drawable/ic_back_arrow" android:tint="@color/sage_text" android:contentDescription="Back" android:layout_marginEnd="12dp" android:layout_width="44dp" android:layout_height="44dp"/>
   <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
    <TextView android:text="Final Step" android:textSize="11sp" android:textStyle="bold" android:textAllCaps="true" android:letterSpacing="0.1" android:textColor="@color/sage_text_soft" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:text="Manual Assets" android:fontFamily="serif" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/sage_text" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
   </LinearLayout>
  </LinearLayout>
 </FrameLayout>

 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
   <TextView android:id="@+id/summaryText" android:textSize="13sp" android:textColor="@color/sage_text_soft" android:lineSpacingExtra="3dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

   <TextView android:text="Business stock / trade goods (৳)" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/sage_text" android:layout_marginTop="16dp" android:layout_marginBottom="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   <EditText android:id="@+id/businessInput" style="@style/Widget.Crescent.EditText" android:hint="0" android:inputType="numberDecimal" android:layout_width="match_parent" android:layout_height="wrap_content"/>

   <TextView android:text="Eligible investments (৳)" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/sage_text" android:layout_marginTop="12dp" android:layout_marginBottom="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   <EditText android:id="@+id/investmentInput" style="@style/Widget.Crescent.EditText" android:hint="0" android:inputType="numberDecimal" android:layout_width="match_parent" android:layout_height="wrap_content"/>

   <TextView android:text="Other short-term liabilities (৳)" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/sage_text" android:layout_marginTop="12dp" android:layout_marginBottom="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   <EditText android:id="@+id/liabilityInput" style="@style/Widget.Crescent.EditText" android:hint="0" android:inputType="numberDecimal" android:layout_width="match_parent" android:layout_height="wrap_content"/>

   <TextView android:text="Nisab threshold in BDT" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/sage_text" android:layout_marginTop="12dp" android:layout_marginBottom="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   <EditText android:id="@+id/nisabInput" style="@style/Widget.Crescent.EditText" android:hint="0" android:inputType="numberDecimal" android:layout_width="match_parent" android:layout_height="wrap_content"/>

   <TextView android:id="@+id/resultText" android:textSize="14sp" android:textColor="@color/sage_text" android:lineSpacingExtra="3dp" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   <TextView android:text="Check the calculation with an expert. This may not be 100% correct." android:textColor="#B71C1C" android:textStyle="bold" android:textSize="12sp" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   <Button android:id="@+id/pdfButton" style="@style/Widget.Crescent.Button.Outlined" android:text="Generate PDF Report" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  </LinearLayout>
 </ScrollView>
 <View android:background="@color/sage_card_stroke" android:layout_width="match_parent" android:layout_height="1dp"/>
 <LinearLayout android:id="@+id/bottomBar" android:orientation="horizontal" android:background="@color/sage_card" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
  <Button android:id="@+id/previousButton" style="@style/Widget.Crescent.Button.Outlined" android:text="Previous" android:layout_marginEnd="6dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
  <Button android:id="@+id/calculateButton" style="@style/Widget.Crescent.Button" android:text="Calculate &amp; Save" android:layout_marginStart="6dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
 </LinearLayout>
</LinearLayout>
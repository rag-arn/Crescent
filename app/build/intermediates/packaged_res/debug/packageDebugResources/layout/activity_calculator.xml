<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
 <LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
  <TextView android:text="Step 4 of 4" android:textSize="13sp" android:textColor="#176B52" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <TextView android:text="Zakat Calculator" android:textSize="26sp" android:textStyle="bold" android:textColor="#176B52" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <TextView android:id="@+id/summaryText" android:layout_marginTop="8dp" android:lineSpacingExtra="3dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <TextView android:text="Add the remaining items in Bangladeshi Taka (BDT)." android:layout_marginTop="12dp" android:layout_marginBottom="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <EditText android:id="@+id/businessInput" android:hint="Business stock / trade goods (৳)" android:inputType="numberDecimal" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <EditText android:id="@+id/investmentInput" android:hint="Eligible investments (৳)" android:inputType="numberDecimal" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <EditText android:id="@+id/liabilityInput" android:hint="Other short-term liabilities (৳), not already entered as cash payable" android:inputType="numberDecimal" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <EditText android:id="@+id/nisabInput" android:hint="Nisab threshold in BDT (required)" android:inputType="numberDecimal" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <Button android:id="@+id/calculateButton" android:text="Calculate and Save Snapshot" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <TextView android:id="@+id/resultText" android:textSize="16sp" android:lineSpacingExtra="5dp" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <Button android:id="@+id/pdfButton" android:text="Generate PDF Report" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <TextView android:text="Check the calculation with an expert. This may not be 100% correct." android:textColor="#C62828" android:textStyle="bold" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <Button android:id="@+id/previousButton" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:text="Previous" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 </LinearLayout>
</ScrollView>
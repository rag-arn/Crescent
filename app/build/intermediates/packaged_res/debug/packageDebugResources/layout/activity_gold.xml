<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:orientation="vertical" android:padding="20dp"
            android:layout_width="match_parent" android:layout_height="wrap_content">

            <TextView android:text="Step 1 of 2" android:textSize="13sp" android:textColor="#176B52"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="Gold" android:textSize="28sp" android:textStyle="bold" android:textColor="#176B52"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="Enter the gold you own. Choose the unit and karat for each entry; the value is converted to Taka (৳) automatically."
                android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

            <TextView android:id="@+id/priceStatus" android:text="Fetching gold price…" android:textSize="15sp"
                android:layout_marginTop="16dp" android:lineSpacingExtra="3dp"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Button android:id="@+id/refreshPriceButton" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:text="Refresh price" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

            <LinearLayout android:id="@+id/rowsContainer" android:orientation="vertical" android:layout_marginTop="8dp"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>

            <Button android:id="@+id/addMoreButton" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:text="+ Add more" android:layout_marginTop="8dp"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>

            <TextView android:id="@+id/totalText" android:text="Total gold value: ৳0" android:textSize="18sp" android:textStyle="bold"
                android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

            <TextView android:text="Prices come from the international spot price (USD per troy ounce) converted to BDT, so they can differ from local jeweller (BAJUS) rates. A troy ounce is 31.1035 g; a regular ounce is 28.3495 g."
                android:textSize="12sp" android:layout_marginTop="12dp"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:orientation="horizontal" android:padding="12dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/previousButton" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:text="Previous" android:layout_marginEnd="6dp"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <Button android:id="@+id/nextButton" android:text="Next" android:layout_marginStart="6dp"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
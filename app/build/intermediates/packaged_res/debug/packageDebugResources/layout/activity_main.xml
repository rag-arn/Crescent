<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerRoot"
    android:background="@color/dark_teal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Extracted main dashboard UI -->
    <include android:id="@+id/dashboard" layout="@layout/layout_dashboard" />

    <!-- Dim scrim over the pushed activity -->
    <View
        android:id="@+id/drawerScrim"
        android:background="#73000000"
        android:visibility="gone"
        android:alpha="0"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Extracted side menu UI -->
    <include android:id="@+id/slideMenu" layout="@layout/layout_slide_menu" />

</FrameLayout>